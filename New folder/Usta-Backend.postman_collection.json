            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"Pass@1234\",\n  \"newPassword\": \"NewPass@123\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/artisan/change-password"
          }
        },
        {
          "name": "Update Notification Settings",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"marketing\": true,\n  \"requests\": true,\n  \"chat\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/artisan/notifications"
          }
        },
        { "name": "Delete Account", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/artisan/account" } }
      ]
    },
    {
      "name": "Notifications",
      "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ] },
      "item": [
        {
          "name": "List Notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.notifications && json.notifications.length) pm.collectionVariables.set('notificationId', json.notifications[0]._id);"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/artisan/notifications" }
        },
        { "name": "Mark Notification Read", "request": { "method": "PUT", "url": "{{baseUrl}}/api/artisan/notifications/{{notificationId}}/read" } }
      ]
    },
    {
      "name": "Analytics & Insights",
      "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ] },
      "item": [
        { "name": "Dashboard", "request": { "method": "GET", "url": "{{baseUrl}}/api/artisan/dashboard" } },
        { "name": "Insights", "request": { "method": "GET", "url": "{{baseUrl}}/api/artisan/insights" } },
        { "name": "Badges", "request": { "method": "GET", "url": "{{baseUrl}}/api/artisan/badges" } },
        { "name": "Tips", "request": { "method": "GET", "url": "{{baseUrl}}/api/artisan/tips" } },
        {
