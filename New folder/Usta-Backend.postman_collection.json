                  "if (json && json.reviews && json.reviews.length) pm.collectionVariables.set('reviewId', json.reviews[0]._id);"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/artisan/reviews" }
        },
        {
          "name": "Reply to Review",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"reply\": \"شكراً على رأيك\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/artisan/reviews/{{reviewId}}/reply"
          }
        },
        { "name": "Average Rating", "request": { "method": "GET", "url": "{{baseUrl}}/api/artisan/reviews/average" } }
      ]
    },
    {
      "name": "Settings & Security",
