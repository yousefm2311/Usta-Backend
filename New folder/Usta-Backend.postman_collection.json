            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmed@example.com\",\n  \"code\": \"{{resetCode}}\",\n  \"newPassword\": \"NewPass@123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/artisan/forgot-password"
