    {
      "name": "Auth & Account",
      "description": "Signup, login, verify, reset, logout",
      "item": [
        {
          "name": "Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.devCode) { pm.collectionVariables.set('verifyCode', json.devCode); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ahmed Ali\",\n  \"phone\": \"01000000000\",\n  \"email\": \"ahmed@example.com\",\n  \"profession\": \"Plumber\",\n  \"password\": \"Pass@1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/artisan/signup"
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.accessToken) { pm.collectionVariables.set('token', json.accessToken); }",
                  "if (json && json.refreshToken) { pm.collectionVariables.set('refreshToken', json.refreshToken); }",
                  "if (json && json.artisan && json.artisan._id) { pm.collectionVariables.set('artisanId', json.artisan._id); }",
                  "pm.test('has token', function () { pm.expect(pm.collectionVariables.get('token')).to.be.ok; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmed@example.com\",\n  \"password\": \"Pass@1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/artisan/login"
          },
          "response": []
        },
        {
          "name": "Token Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.accessToken) { pm.collectionVariables.set('token', json.accessToken); }",
                  "if (json && json.refreshToken) { pm.collectionVariables.set('refreshToken', json.refreshToken); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/artisan/token/refresh"
          }
        },
        {
          "name": "Verify (by code)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmed@example.com\",\n  \"code\": \"{{verifyCode}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/artisan/verify"
          },
          "response": []
        },
        {
          "name": "Verify (upload ID image)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"01000000000\",\n  \"idImage\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAAB\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/artisan/verify"
          },
          "response": []
        },
        {
          "name": "Forgot Password (request code)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.devCode) { pm.collectionVariables.set('resetCode', json.devCode); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmed@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/artisan/forgot-password"
          }
        },
        {
          "name": "Forgot Password (confirm reset)",
