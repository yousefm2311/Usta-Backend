const { parseJson } = require('../utils/body');
const { sendJson, sendError } = require('../utils/response');
const { connect, ObjectId } = require('../db');
const { hashPassword, verifyPassword } = require('../utils/crypto');
const { signAccessToken, generateRefreshToken, hashToken } = require('../utils/token');
const config = require('../config');
const { requireAuth } = require('../utils/auth');
const { saveBase64ImageToUploads, deletePublicPath } = require('../utils/files');

function sanitizeArtisan(artisan) {
  if (!artisan) return null;
  const { password, deleted, ...rest } = artisan;
  return rest;
}

function nowPlusDays(d) {
  const date = new Date();
  date.setDate(date.getDate() + d);
  return date;
}

// Auth & Account
async function signup(req, res) {
  const body = await parseJson(req, res);
  if (res.writableEnded) return;
  const { name, phone, email, profession, password } = body || {};
  if (!name || !phone || !profession || !password) return sendError(res, 400, 'Missing required fields');
  const db = await connect();
  const exists = await db.collection('artisans').findOne({ $or: [{ phone }, ...(email ? [{ email }] : [])] });
  if (exists) return sendError(res, 409, 'Phone or email already registered');
  const pass = hashPassword(password);
  const doc = {
    name,
    phone,
    email: email || null,
    profession,
    password: pass,
    createdAt: new Date(),
    verified: false,
    services: [],
    pricing: [],
    portfolio: [],
    status: 'available',
    notifications: { marketing: true, requests: true, chat: true },
  };
  const r = await db.collection('artisans').insertOne(doc);
  const artisan = { ...doc, _id: r.insertedId };
  // issue a verification code
  const code = (Math.floor(Math.random() * 900000) + 100000).toString();
  await db.collection('verification_codes').insertOne({
    artisanId: r.insertedId,
    code,
    type: 'signup',
    createdAt: new Date(),
    expiresAt: nowPlusDays(2),
  });
  sendJson(res, 201, { artisan: sanitizeArtisan(artisan), message: 'Signup successful. Verify your account.', devCode: code });
}

async function login(req, res) {
  const body = await parseJson(req, res);
  if (res.writableEnded) return;
  const { phone, email, password } = body || {};
  if ((!phone && !email) || !password) return sendError(res, 400, 'Missing credentials');
  const db = await connect();
  const artisan = await db.collection('artisans').findOne({
    $or: [ ...(phone ? [{ phone }] : []), ...(email ? [{ email }] : []) ],
    deleted: { $ne: true },
  });
  if (!artisan || !verifyPassword(password, artisan.password)) return sendError(res, 401, 'Invalid credentials');
  const accessToken = signAccessToken(artisan._id);
  const refreshToken = generateRefreshToken();
  await db.collection('refresh_tokens').insertOne({
    tokenHash: hashToken(refreshToken),
    artisanId: artisan._id,
    createdAt: new Date(),
    expiresAt: new Date(Date.now() + config.refreshTtlSec * 1000),
    revoked: false,
  });
  sendJson(res, 200, { accessToken, refreshToken, artisan: sanitizeArtisan(artisan) });
}

async function verify(req, res) {
  const body = await parseJson(req, res);
  if (res.writableEnded) return;
  const { phone, email, code, idImage } = body || {};
  const db = await connect();
  const artisan = await db.collection('artisans').findOne({ $or: [ ...(phone ? [{ phone }] : []), ...(email ? [{ email }] : []) ] });
  if (!artisan) return sendError(res, 404, 'Account not found');
  let updated = {};
  if (code) {
    const vc = await db.collection('verification_codes').findOne({ artisanId: artisan._id, code, type: 'signup' });
    if (!vc) return sendError(res, 400, 'Invalid code');
    updated.verified = true;
  }
  if (idImage) {
    const save = saveBase64ImageToUploads('ids', `${artisan._id}-${Date.now()}`, idImage);
    updated.idImage = save.rel;
  }
  if (!Object.keys(updated).length) return sendError(res, 400, 'Nothing to verify');
  await db.collection('artisans').updateOne({ _id: artisan._id }, { $set: updated });
  sendJson(res, 200, { ok: true });
}

async function forgotPassword(req, res) {
  const body = await parseJson(req, res);
  if (res.writableEnded) return;
  const { phone, email, code, newPassword } = body || {};
  const db = await connect();
  const artisan = await db.collection('artisans').findOne({ $or: [ ...(phone ? [{ phone }] : []), ...(email ? [{ email }] : []) ] });
  if (!artisan) return sendError(res, 404, 'Account not found');
  if (!code && !newPassword) {
    const resetCode = (Math.floor(Math.random() * 900000) + 100000).toString();
    await db.collection('verification_codes').insertOne({ artisanId: artisan._id, code: resetCode, type: 'reset', createdAt: new Date(), expiresAt: nowPlusDays(1) });
    return sendJson(res, 200, { message: 'Reset code generated', devCode: resetCode });
  }
  if (code && newPassword) {
    const found = await db.collection('verification_codes').findOne({ artisanId: artisan._id, code, type: 'reset' });
    if (!found) return sendError(res, 400, 'Invalid code');
    const pass = hashPassword(newPassword);
    await db.collection('artisans').updateOne({ _id: artisan._id }, { $set: { password: pass } });
    return sendJson(res, 200, { message: 'Password updated' });
  }
  return sendError(res, 400, 'Invalid request');
}

async function logout(req, res) {
  const auth = await requireAuth(req, res);
  if (!auth) return;
  const body = await parseJson(req, res);
  if (res.writableEnded) return;
  const { refreshToken, allDevices } = body || {};
  const db = await connect();
  if (allDevices) {
    await db.collection('refresh_tokens').updateMany({ artisanId: auth.artisan._id, revoked: { $ne: true } }, { $set: { revoked: true, revokedAt: new Date() } });
  } else if (refreshToken) {
    await db.collection('refresh_tokens').updateOne({ tokenHash: hashToken(refreshToken) }, { $set: { revoked: true, revokedAt: new Date() } });
  }
  sendJson(res, 200, { ok: true });
}

async function refreshToken(req, res) {
  const body = await parseJson(req, res);
  if (res.writableEnded) return;
  const { refreshToken } = body || {};
  if (!refreshToken) return sendError(res, 400, 'refreshToken required');
  const db = await connect();
  const doc = await db.collection('refresh_tokens').findOne({ tokenHash: hashToken(refreshToken) });
  if (!doc || doc.revoked) return sendError(res, 401, 'Invalid refresh token');
  if (doc.expiresAt && doc.expiresAt.getTime() < Date.now()) return sendError(res, 401, 'Refresh token expired');
  const artisan = await db.collection('artisans').findOne({ _id: new ObjectId(doc.artisanId), deleted: { $ne: true } });
  if (!artisan) return sendError(res, 401, 'Account not found');
  // rotate
  await db.collection('refresh_tokens').updateOne({ _id: doc._id }, { $set: { revoked: true, rotatedAt: new Date() } });
  const newRefresh = generateRefreshToken();
  await db.collection('refresh_tokens').insertOne({
    tokenHash: hashToken(newRefresh),
    artisanId: artisan._id,
    createdAt: new Date(),
    expiresAt: new Date(Date.now() + config.refreshTtlSec * 1000),
    revoked: false,
  });
  const newAccess = signAccessToken(artisan._id);
  sendJson(res, 200, { accessToken: newAccess, refreshToken: newRefresh });
}

// Profile & Portfolio
async function getProfile(req, res) {
  const auth = await requireAuth(req, res);
  if (!auth) return;
  sendJson(res, 200, { artisan: sanitizeArtisan(auth.artisan) });
}

async function updateProfile(req, res) {
  const auth = await requireAuth(req, res);
  if (!auth) return;
  const body = await parseJson(req, res);
  if (res.writableEnded) return;
  const allowed = ['name', 'description', 'phone', 'email', 'address'];
  const toSet = {};
  for (const k of allowed) if (body[k] !== undefined) toSet[k] = body[k];
  const db = await connect();
  if (body.avatar) {
    const saved = saveBase64ImageToUploads('avatars', `${auth.artisan._id}-${Date.now()}`, body.avatar);
    toSet.avatar = saved.rel;
    if (auth.artisan.avatar && auth.artisan.avatar !== toSet.avatar) deletePublicPath(auth.artisan.avatar);
  }
  if (Object.keys(toSet).length === 0) return sendError(res, 400, 'No changes provided');
  if (toSet.phone) {
    const exists = await db.collection('artisans').findOne({ _id: { $ne: auth.artisan._id }, phone: toSet.phone });
    if (exists) return sendError(res, 409, 'Phone already used');
  }
  if (toSet.email) {
    const exists = await db.collection('artisans').findOne({ _id: { $ne: auth.artisan._id }, email: toSet.email });
    if (exists) return sendError(res, 409, 'Email already used');
  }
  await db.collection('artisans').updateOne({ _id: auth.artisan._id }, { $set: toSet });
  sendJson(res, 200, { ok: true });
}

async function addPortfolioItem(req, res) {
  const auth = await requireAuth(req, res);
  if (!auth) return;
  const body = await parseJson(req, res, 10 * 1024 * 1024);
  if (res.writableEnded) return;
  const { image, description } = body || {};
  if (!image) return sendError(res, 400, 'Image required');
  const saved = saveBase64ImageToUploads('portfolio', `${auth.artisan._id}-${Date.now()}`, image);
  const item = { _id: new ObjectId(), path: saved.rel, description: description || '', createdAt: new Date() };
  const db = await connect();
  await db.collection('artisans').updateOne({ _id: auth.artisan._id }, { $push: { portfolio: item } });
  sendJson(res, 201, { item });
}

async function deletePortfolioItem(req, res, params) {
  const auth = await requireAuth(req, res);
  if (!auth) return;
  const id = params.id;
  const db = await connect();
  const doc = await db.collection('artisans').findOne({ _id: auth.artisan._id }, { projection: { portfolio: 1 } });
  const item = (doc.portfolio || []).find((p) => String(p._id) === String(id));
  await db.collection('artisans').updateOne({ _id: auth.artisan._id }, { $pull: { portfolio: { _id: new ObjectId(id) } } });
  if (item && item.path) deletePublicPath(item.path);
  sendJson(res, 200, { ok: true });
}

async function updateLocation(req, res) {
  const auth = await requireAuth(req, res);
  if (!auth) return;
  const body = await parseJson(req, res);
  if (res.writableEnded) return;
  const { lat, lng } = body || {};
  if (typeof lat !== 'number' || typeof lng !== 'number') return sendError(res, 400, 'Invalid coordinates');
  const db = await connect();
  await db.collection('artisans').updateOne(
    { _id: auth.artisan._id },
    { $set: { location: { type: 'Point', coordinates: [lng, lat] }, locationUpdatedAt: new Date() } }
  );
  sendJson(res, 200, { ok: true });
}

async function updateStatus(req, res) {
  const auth = await requireAuth(req, res);
  if (!auth) return;
  const body = await parseJson(req, res);
  if (res.writableEnded) return;
  const { status } = body || {};
  if (!['available', 'busy'].includes(status)) return sendError(res, 400, 'Invalid status');
  const db = await connect();
  await db.collection('artisans').updateOne({ _id: auth.artisan._id }, { $set: { status } });
  sendJson(res, 200, { ok: true });
}

// Services & Pricing
async function setServices(req, res) {
  const auth = await requireAuth(req, res);
  if (!auth) return;
  const body = await parseJson(req, res);
  if (res.writableEnded) return;
  const { services } = body || {};
  if (!Array.isArray(services)) return sendError(res, 400, 'services must be array');
  const normalized = services.map((name) => ({ _id: new ObjectId(), name: String(name) }));
  const db = await connect();
  await db.collection('artisans').updateOne({ _id: auth.artisan._id }, { $set: { services: normalized } });
  sendJson(res, 200, { services: normalized });
}

async function updateService(req, res, params) {
  const auth = await requireAuth(req, res);
  if (!auth) return;
  const body = await parseJson(req, res);
  if (res.writableEnded) return;
  const { name } = body || {};
  if (!name) return sendError(res, 400, 'name required');
  const id = params.id;
  const db = await connect();
  await db.collection('artisans').updateOne(
    { _id: auth.artisan._id, 'services._id': new ObjectId(id) },
    { $set: { 'services.$.name': String(name) } }
  );
  sendJson(res, 200, { ok: true });
}

async function deleteService(req, res, params) {
  const auth = await requireAuth(req, res);
  if (!auth) return;
  const id = params.id;
  const db = await connect();
  await db.collection('artisans').updateOne({ _id: auth.artisan._id }, { $pull: { services: { _id: new ObjectId(id) } } });
  sendJson(res, 200, { ok: true });
}

async function setPricing(req, res) {
  const auth = await requireAuth(req, res);
  if (!auth) return;
  const body = await parseJson(req, res);
  if (res.writableEnded) return;
  const { pricing } = body || {};
  if (!Array.isArray(pricing)) return sendError(res, 400, 'pricing must be array');
  const normalized = pricing.map((p) => ({ _id: new ObjectId(), serviceName: p.serviceName, min: Number(p.min), max: Number(p.max), currency: p.currency || 'EGP' }));
  const db = await connect();
  await db.collection('artisans').updateOne({ _id: auth.artisan._id }, { $set: { pricing: normalized } });
  sendJson(res, 200, { pricing: normalized });
}

// Wallet & Earnings
async function getWallet(req, res) {
  const auth = await requireAuth(req, res);
  if (!auth) return;
  const db = await connect();
  const agg = await db.collection('transactions').aggregate([
    { $match: { artisanId: auth.artisan._id } },
    { $group: { _id: null, balance: { $sum: { $subtract: ['$credit', '$debit'] } } } },
  ]).toArray();
  const balance = agg[0]?.balance || 0;
  sendJson(res, 200, { balance });
}

async function getEarnings(req, res) {
  const auth = await requireAuth(req, res);
  if (!auth) return;
  const db = await connect();
  const daily = await db.collection('transactions').aggregate([
    { $match: { artisanId: auth.artisan._id, credit: { $gt: 0 } } },
    { $group: { _id: { $dateToString: { format: '%Y-%m-%d', date: '$createdAt' } }, total: { $sum: '$credit' } } },
    { $sort: { _id: 1 } },
  ]).toArray();
  const monthly = await db.collection('transactions').aggregate([
    { $match: { artisanId: auth.artisan._id, credit: { $gt: 0 } } },
    { $group: { _id: { $dateToString: { format: '%Y-%m', date: '$createdAt' } }, total: { $sum: '$credit' } } },
    { $sort: { _id: 1 } },
  ]).toArray();
  sendJson(res, 200, { daily, monthly });
}

async function withdraw(req, res) {
  const auth = await requireAuth(req, res);
  if (!auth) return;
  const body = await parseJson(req, res);
  if (res.writableEnded) return;
  const amount = Number(body.amount || 0);
  if (!(amount > 0)) return sendError(res, 400, 'Invalid amount');
  const db = await connect();
  const agg = await db.collection('transactions').aggregate([
    { $match: { artisanId: auth.artisan._id } },
    { $group: { _id: null, balance: { $sum: { $subtract: ['$credit', '$debit'] } } } },
  ]).toArray();
  const balance = agg[0]?.balance || 0;
  if (amount > balance) return sendError(res, 400, 'Insufficient balance');
  await db.collection('transactions').insertOne({ artisanId: auth.artisan._id, credit: 0, debit: amount, type: 'withdraw', status: 'pending', createdAt: new Date() });
  sendJson(res, 200, { message: 'Withdrawal requested' });
}

async function addPaymentMethod(req, res) {
  const auth = await requireAuth(req, res);
  if (!auth) return;
  const body = await parseJson(req, res);
  if (res.writableEnded) return;
  const { type, details } = body || {};
  if (!['vodafoneCash', 'bank'].includes(type)) return sendError(res, 400, 'Invalid type');
  const db = await connect();
  await db.collection('artisans').updateOne({ _id: auth.artisan._id }, { $set: { paymentMethod: { type, details } } });
  sendJson(res, 200, { ok: true });
}

// Settings & Security
async function changePassword(req, res) {
  const auth = await requireAuth(req, res);
  if (!auth) return;
  const body = await parseJson(req, res);
  if (res.writableEnded) return;
  const { currentPassword, newPassword } = body || {};
  if (!currentPassword || !newPassword) return sendError(res, 400, 'Missing fields');
  if (!verifyPassword(currentPassword, auth.artisan.password)) return sendError(res, 400, 'Current password incorrect');
  const pass = hashPassword(newPassword);
  const db = await connect();
  await db.collection('artisans').updateOne({ _id: auth.artisan._id }, { $set: { password: pass } });
  sendJson(res, 200, { ok: true });
}

async function updateNotificationSettings(req, res) {
  const auth = await requireAuth(req, res);
  if (!auth) return;
  const body = await parseJson(req, res);
  if (res.writableEnded) return;
  const { marketing, requests: rq, chat } = body || {};
  const update = {};
  if (marketing !== undefined) update['notifications.marketing'] = !!marketing;
  if (rq !== undefined) update['notifications.requests'] = !!rq;
  if (chat !== undefined) update['notifications.chat'] = !!chat;
  if (!Object.keys(update).length) return sendError(res, 400, 'No changes');
  const db = await connect();
  await db.collection('artisans').updateOne({ _id: auth.artisan._id }, { $set: update });
  sendJson(res, 200, { ok: true });
}

async function deleteAccount(req, res) {
  const auth = await requireAuth(req, res);
  if (!auth) return;
  const db = await connect();
  const doc = await db.collection('artisans').findOne({ _id: auth.artisan._id });
  if (doc?.avatar) deletePublicPath(doc.avatar);
  for (const p of doc?.portfolio || []) if (p.path) deletePublicPath(p.path);
  await db.collection('sessions').deleteMany({ artisanId: auth.artisan._id });
  await db.collection('artisans').updateOne({ _id: auth.artisan._id }, { $set: { deleted: true, deletedAt: new Date() } });
  sendJson(res, 200, { ok: true });
}

module.exports = {
  signup,
  login,
  verify,
  forgotPassword,
  logout,
  refreshToken,
  getProfile,
  updateProfile,
  addPortfolioItem,
  deletePortfolioItem,
  updateLocation,
  updateStatus,
  setServices,
  updateService,
  deleteService,
  setPricing,
  getWallet,
  getEarnings,
  withdraw,
  addPaymentMethod,
  changePassword,
  updateNotificationSettings,
  deleteAccount,
};
