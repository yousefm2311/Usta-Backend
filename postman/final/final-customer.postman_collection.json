      {"name":"Upload Photo", "request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/customer/profile/photo","body":{"mode":"raw","raw":"{ \"photo\": \"data:image/jpeg;base64,...\" }"}}},
      {"name":"Delete Account", "request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/customer/account"}}
    ]},
    {"name":"Preferences", "item":[
