      {"name":"Language", "request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/customer/language","body":{"mode":"raw","raw":"{ \"language\": \"en\" }"}}},
