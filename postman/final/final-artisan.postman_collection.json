            }
          },
          "description": "Artisan can send only if the customer has already created a request for this artisan."
        },
        {
          "name": "Block Chat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
