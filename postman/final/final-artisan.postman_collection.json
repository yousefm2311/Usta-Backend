                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/chat/{{requestId}}"
          }
        },
        {
          "name": "Get Messages",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
