              "mode": "raw",
              "raw": "{ \"otherId\": \"{{customerId}}\", \"reason\": \"spam\" }"
            }
          },
          "description": "Blocks chat in both directions for this customer-artisan pair."
        },
        {
          "name": "Unblock Chat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
