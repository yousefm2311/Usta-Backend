{
  "info": {
    "name": "Usta Artisan KYC",
    "_postman_id": "d0fa9673-fc39-4bca-bdc1-cd70c3a9f8e6",
    "description": "Artisan-only identity verification flow for Usta.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://usta.qzz.io"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Get Verification Status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/verification/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "verification",
            "status"
          ]
        }
      }
    },
    {
      "name": "Upload ID Images",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "idFront",
              "type": "file",
              "src": ""
            },
            {
              "key": "idBack",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/verification/upload-id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "verification",
            "upload-id"
          ]
        }
      }
    },
    {
      "name": "Upload Selfie",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "selfie",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/verification/upload-selfie",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "verification",
            "upload-selfie"
          ]
        }
      }
    },
    {
      "name": "Admin - List Verifications",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/verifications",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "verifications"
          ]
        }
      }
    },
    {
      "name": "Admin - Verification Details",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/verifications/:id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "verifications",
            ":id"
          ]
        }
      }
    },
    {
      "name": "Admin - Approve Verification",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/verifications/:id/approve",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "verifications",
            ":id",
            "approve"
          ]
        }
      }
    },
    {
      "name": "Admin - Reject Verification",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rejectionReasonUserSafe\": \"الوجه لا يطابق الهوية.\",\n  \"rejectionReasonInternal\": \"admin_manual_reject\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/verifications/:id/reject",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "verifications",
            ":id",
            "reject"
          ]
        }
      }
    }
